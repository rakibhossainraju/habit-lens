# SQLite database file used by Prisma (see src/lib/prisma.ts).
DATABASE_URL="file:./dev.db"

# Auth.js session/JWT signing secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP connection string used to send magic-link emails, e.g.
#   EMAIL_SERVER="smtp://user:pass@smtp.resend.com:465"
EMAIL_SERVER=""
EMAIL_FROM="Habit Lens <noreply@habitlens.app>"

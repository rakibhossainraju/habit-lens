generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model LogEntry {
  id              String        @id @default(cuid())
  date            String
  sleepTime       String
  wakeTime        String
  sleepDuration   Float
  morningEnergy   Int
  afternoonEnergy Int
  eveningEnergy   Int
  notes           String        @default("")
  customFields    CustomField[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([date])
}

model CustomField {
  id        String   @id @default(cuid())
  key       String
  value     String
  logId     String
  log       LogEntry @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
}
